{
  "name": "dsh-session-bridge",
  "version": "2.3.3",
  "description": "把你自己已登录的浏览器变成 DSH 的 browser_* 工具：不新开实例、不抢焦点、多浏览器并存，所有操作都在后台完成。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": {
    "name": "wxs-lang",
    "url": "https://github.com/wxs-lang"
  },
  "contributors": [
    {
      "name": "wxs-lang",
      "url": "https://github.com/wxs-lang"
    }
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "browser-automation",
    "chrome-extension",
    "cdp",
    "ai-agent",
    "background-control"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxs-lang/dsh-session-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/wxs-lang/dsh-session-bridge/issues"
  },
  "homepage": "https://github.com/wxs-lang/dsh-session-bridge#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "impl.js",
    "native-host.mjs",
    "dsh-session-native.cmd",
    "com.dsh.session.json.example",
    "cordis.patch.yml",
    "extension/**/*",
    "README.md",
    "CHANGELOG.md",
    "TROUBLESHOOTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:unit": "node test/resilience.mjs && node test/multi-browser.mjs && node test/icons.mjs && node test/yaml-check.mjs",
    "test:e2e": "node test/focus.mjs && node test/groups.mjs && node test/theme.mjs",
    "test:live": "node test/live.mjs && node test/smoke.mjs"
  }
}
